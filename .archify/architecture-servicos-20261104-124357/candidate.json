  "cards": [
    {
      "dot": "cyan",
      "title": "Serviços",
      "items": [
        "O gateway é a única porta pública e só encaminha.",
        "Cobrança, conciliação e cadastro não se chamam para dar baixa.",
        "Cadastro atende títulos, configuração e o webhook do emissor."
      ]
    },
    {
      "dot": "amber",
      "title": "Régua",
      "items": [
        "O relo-disp publica run_dunning às 07:00. O worker responde pela Evolution.",
        "O worker de cobrança também chama o LLM na conversa."
      ]
    },
    {
      "dot": "emerald",
      "title": "Reconciliação",
      "items": [
        "O matching não usa LLM.",
        "O comprovante fica no MinIO.",
        "Sem o banco, o match continua provisório."
      ]
    },
    {
      "dot": "violet",
      "title": "Observabilidade",
      "items": [
        "Liga quando OTEL_EXPORTER_OTLP_ENDPOINT está preenchido.",
        "Gateway, cobrança, conciliação, cadastro e os workers exportam OTLP.",
        "O Prometheus raspa /internal/metrics. O Promtail manda o log dos pods ao Loki."
      ]
    }
  ]
